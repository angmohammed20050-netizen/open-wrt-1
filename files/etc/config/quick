# ===========================================================================
#  ملف كونفك Quick Pro (ZTE E8822 Edition)
# ===========================================================================

config theme 'theme'
	option menu_layout 'side'
	option icon_shape 'squircle'
	option icon_style 'glass'
	option bg_type 'gradient'
	option bg_preset 'royal'
	option bg_color1 '#0a0a1f'
	option bg_color2 '#3b1f7a'
	option bg_image ''
	option blur '14'
	option accent '#7c5cff'
	option login_bg_type 'none'
	option login_bg ''
	option login_dim '45'

config main 'main'
	option lan_if 'br-lan'
	option speed_url 'https://speed.cloudflare.com/__down?bytes=50000000'
	option speed_secs '8'
	option offload_auto '1'
	option force_dns '0'
	option block_dot '0'

config perf 'perf'
	option clean_enable '0'
	option clean_cron '0 4 * * *'
	option clean_cache '1'
	option clean_dns '1'
	option clean_conntrack '0'
	option clean_logs '0'
	option conntrack_max ''
	option bbr '0'

config loop 'loop'
	option enabled '1'
	option stp '1'
	option storm_enable '1'
	option storm_pps '150'
	option mcast_pps '250'

config resetbtn 'resetbtn'
	option mode 'normal'
	option hold_secs '5'

config reboot 'reboot'
	option enabled '0'
	option mode 'daily'
	option hour '4'
	option minute '0'
	option weekday '0'
	option custom_cron '0 4 * * *'

config wifisched 'wifisched'
	option enabled '0'
	option target 'all'
	option off_hour '2'
	option off_min '0'
	option on_hour '7'
	option on_min '0'
	option days '*'

config neighbors 'neighbors'
	option mndp_enable '1'
	option lldp_enable '0'
	option identity 'ZTE-E8822-Quick'
	option platform 'ZTE E8822'
	option iface 'br-lan'
	option interval '60'

config protect 'protect'
	option block_backup '1'
	option lock_cgi_backup '1'
	option customer_lock '0'
	option lock_ssh_lan '0'
	option brand_name 'Quick Pro'
