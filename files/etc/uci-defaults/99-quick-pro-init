#!/bin/sh
chmod 755 /usr/libexec/quick-ctl /usr/libexec/quick-apply.sh /usr/libexec/quick-mndp.uc /usr/libexec/quick-sync.sh /etc/init.d/quick 2>/dev/null
/usr/libexec/quick-sync.sh activate 2>/dev/null
uci -q set system.@system[0].hostname='ZTE-E8822-Quick'
uci -q set system.@system[0].zonename='Asia/Aden'
uci -q set system.@system[0].timezone='AST-3'
uci -q commit system
/etc/init.d/quick enable 2>/dev/null
exit 0
