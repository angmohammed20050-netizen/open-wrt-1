CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_zte_e8820v2=y

# Core LuCI + uCode + Theme dependencies
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_ucode-mod-uci=y
CONFIG_PACKAGE_ucode-mod-ubus=y
CONFIG_PACKAGE_ucode-mod-socket=y

# Network, Firewall (nftables), WiFi & Quick Pro tools
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_kmod-mt76x2=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_lldpd=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# Keep lean for 64MB RAM / 16MB Flash
# CONFIG_PACKAGE_ipv6helper is not set
CONFIG_PACKAGE_zram-swap=y
